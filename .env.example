# FrankBoard Environment Variables
# Copy to .env and customize. Do NOT commit .env to version control.
# Used for VPS-first Docker deployment. See docs/deployment/vps-docker-staging.md
#
# Database (PostgreSQL)
POSTGRES_USER=kanboard
POSTGRES_PASSWORD=kanboard-secret
POSTGRES_DB=kanboard

# Application
APP_PORT=8080
KANBOARD_IMAGE=kanboard/kanboard:v1.2.51

# Security: set to true only for trusted dev environments to enable web-based plugin install
PLUGIN_INSTALLER=false

# Reverse proxy (optional) — when behind nginx/Caddy/Traefik with proxy auth
# REVERSE_PROXY_AUTH=false
# TRUSTED_PROXY_NETWORKS=172.16.0.0/12,10.0.0.0/8
# TRUSTED_PROXY_HEADERS=HTTP_X_REAL_IP,HTTP_X_FORWARDED_FOR
